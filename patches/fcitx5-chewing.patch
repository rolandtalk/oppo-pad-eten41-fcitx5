+void ChewingEngine::commitWithAssociation(InputContext *ic, std::string text) {
+    if (text.empty()) {
+        associationCandidates_.clear();
+        return;
+    }
+    ic->commitString(text);
+    appendAssociationContext(text);
+    associationCandidates_ = associationsFor(associationContext_);
+}
+
+void ChewingEngine::selectAssociation(InputContext *ic, std::string text) {
+    if (chewing_buffer_Check(context_.get()) &&
+        chewing_commit_preedit_buf(context_.get()) == 0) {
+        const auto preedit = safeChewing_commit_String(context_.get());
+        if (!preedit.empty()) {
+            ic->commitString(preedit);
+            appendAssociationContext(preedit);
+        }
+    }
+    commitWithAssociation(ic, std::move(text));
+    updateUI(ic);
+}
+
+void ChewingEngine::loadAssociations() {
+    const auto path = StandardPaths::global().locate(
+        StandardPathsType::Data, "libchewing/associations.tsv");
+    if (path.empty()) {
+        return;
+    }
+
+    std::ifstream input(path);
+    if (!input) {
+        return;
+    }
+
+    associations_.reserve(85000);
+    std::string line;
+    while (std::getline(input, line)) {
+        if (line.empty() || line.front() == '#') {
+            continue;
+        }
+        const auto firstTab = line.find('\t');
+        if (firstTab == std::string::npos) {
+            continue;
+        }
+        auto &candidates = associations_[line.substr(0, firstTab)];
+        size_t start = firstTab + 1;
+        while (start < line.size()) {
+            const auto end = line.find('\t', start);
+            candidates.emplace_back(line.substr(start, end - start));
+            if (end == std::string::npos) {
+                break;
+            }
+            start = end + 1;
+        }
+    }
+}
+
+std::vector<std::string>
+ChewingEngine::associationsFor(std::string_view text) const {
+    std::vector<size_t> characterStarts;
+    size_t start = text.size();
+    while (start > 0 && characterStarts.size() < 4) {
+        --start;
+        while (start > 0 &&
+               (static_cast<unsigned char>(text[start]) & 0xc0) == 0x80) {
+            --start;
+        }
+        characterStarts.push_back(start);
+    }
+
+    for (auto iter = characterStarts.rbegin(); iter != characterStarts.rend();
+         ++iter) {
+        const auto association = associations_.find(std::string(text.substr(*iter)));
+        if (association != associations_.end()) {
+            return association->second;
+        }
+    }
+    return {};
+}
+
+void ChewingEngine::appendAssociationContext(std::string_view text) {
+    associationContext_.append(text);
+    size_t start = associationContext_.size();
+    int characters = 0;
+    while (start > 0 && characters < 4) {
+        --start;
+        while (start > 0 &&
+               (static_cast<unsigned char>(associationContext_[start]) & 0xc0) ==
+                   0x80) {
+            --start;
+        }
+        ++characters;
+    }
+    if (start > 0) {
+        associationContext_.erase(0, start);
+    }
+}
